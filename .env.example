# Krispy uses the existing krispy22 public Firebase client configuration by default.
# Optional Firebase web-app overrides (public client values, never admin secrets):
# REACT_APP_FIREBASE_API_KEY=your_firebase_web_api_key
# REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=your_project_id
# Enable Authentication > Sign-in method > Email/Password in the Firebase console.
# Optional local development:
# PORT=3000
# BROWSER=none
#
# Globe's official Twitch player uses the current page hostname as its parent.
# Public pages require HTTPS. Local development accepts localhost/loopback.
# Only when Krispy itself is embedded in another site, list those actual ancestor
# hostnames here (no URL schemes, ports or wildcards):
# REACT_APP_KRISPY_TWITCH_PARENT_DOMAINS=actual-ancestor.example
# The final public domain/player must be tested before deployment.
#
# Browser tests: install Chromium with npx playwright install chromium.
# Or set KRISPY_BROWSER_PATH to your installed Chrome executable.
