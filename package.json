{
  "name": "krispy",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.2",
    "firebase": "12.19.0",
    "hls.js": "^1.7.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:public": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false --runInBand",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js --max-warnings=0",
    "test:watch": "react-scripts test",
    "test:browser": "playwright test",
    "test:live-tv": "react-scripts test --watchAll=false --runInBand --runTestsByPath src/data/liveTVAdapter.test.js src/data/publicTVPermissions.test.js src/media/providers.liveTV.test.js src/media/liveTVPlayback.test.js",
    "test:movies-tools": "node --test scripts/movies/browser.test.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@playwright/test": "^1.64.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
